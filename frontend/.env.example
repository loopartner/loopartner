# Adresse publique de l'API Laravel, sans slash final (même domaine parent que le frontend,
# pour que les cookies de session Sanctum fonctionnent : app.loopartner.com et api.loopartner.com).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Aperçus Vercel uniquement : données et comptes fictifs, aucun appel à l'API. Jamais en production.
NEXT_PUBLIC_DEMO_MODE=false
