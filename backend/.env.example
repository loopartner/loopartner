APP_NAME=Loopartner
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Données de démonstration (comptes <rôle>@example.com / password). Mettre à true en local
# uniquement : le seeder refuse si APP_ENV n'est pas local, si APP_DEBUG est false ou si
# APP_URL n'est pas locale. Jamais en production.
SEED_DEMO_DATA=false

# Proxys de confiance (IP ou plages CIDR, séparées par des virgules). Vide : X-Forwarded-* ignoré.
# À renseigner si l'API passe derrière Cloudflare ou un autre proxy (sinon IP et HTTPS mal détectés).
TRUSTED_PROXIES=

# Domaines refusés dans les liens saisis par les utilisateurs (événements…), séparés par des
# virgules, sous-domaines compris (exemple : arnaque.example,spam.example). Les adresses IP, les
# hôtes locaux et les raccourcisseurs de liens sont toujours refusés (config/security.php, links).
# security:check-config vérifie que chaque entrée est un nom de domaine.
DENIED_LINK_DOMAINS=

# Règles administratives (module Compliance) : principe des « quatre yeux ». true : l'admin qui
# vérifie une règle ne peut pas en être le dernier auteur. false par défaut tant que l'équipe ne
# compte qu'un admin (la note de vérification, obligatoire, dit qui a vérifié et sur quelle
# source). security:check-config avertit si false alors que deux admins ont la 2FA.
COMPLIANCE_REQUIRE_DISTINCT_VERIFIER=false

# Signalements et modération (module Moderation, règlement sur les services numériques) : points
# de contact publiés par GET /moderation/info, en français et en anglais (art. 12 : utilisateurs ;
# art. 11 : autorités, Commission et comité). Obligatoires en production (security:check-config).
MODERATION_CONTACT_EMAIL=contact@loopartner.com
MODERATION_AUTHORITIES_EMAIL=legal@loopartner.com
# true : l'admin qui a pris une décision ne peut pas trancher le recours contre elle. false par
# défaut tant que l'équipe ne compte qu'un admin ; security:check-config avertit si false alors
# que deux admins ont la 2FA.
MODERATION_REQUIRE_DISTINCT_APPEAL_REVIEWER=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Journal de sécurité (canal security) : durée de conservation en jours. Voir SECURITY.md.
SECURITY_LOG_DAYS=30

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost
SANCTUM_STATEFUL_DOMAINS=localhost:3000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Stockage des médias (images) : "public" en local (php artisan storage:link), "r2" en production.
MEDIA_DISK=public

# Cloudflare R2 (disque "r2"). R2_ENDPOINT : https://<account_id>.r2.cloudflarestorage.com
# R2_PUBLIC_URL : domaine public du bucket (domaine personnalisé ou r2.dev), sans slash final.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_PUBLIC_URL=
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------------------------
# Production : valeurs attendues par `php artisan security:check-config` (lancée à chaque
# déploiement, elle échoue sur toute valeur dangereuse). Voir aussi SECURITY.md.
# ---------------------------------------------------------------------------------------------
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://api.loopartner.fr
# FRONTEND_URL=https://app.loopartner.fr
# LOG_LEVEL=warning
# SESSION_DRIVER=database
# SESSION_ENCRYPT=true
# SESSION_SECURE_COOKIE=true
# SESSION_HTTP_ONLY=true
# SESSION_SAME_SITE=lax
# SESSION_DOMAIN=.loopartner.fr
# SANCTUM_STATEFUL_DOMAINS=app.loopartner.fr
# MAIL_MAILER=smtp
# QUEUE_CONNECTION=database
# MEDIA_DISK=r2
# SEED_DEMO_DATA=false
# TRUSTED_PROXIES=          (plages du proxy, par exemple celles de Cloudflare)
