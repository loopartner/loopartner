<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Arch">
            <directory>tests/Arch</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- Toute la suite tourne dans un seul processus, avec des images GD en mémoire : 128 Mo ne suffisent plus. -->
        <ini name="memory_limit" value="1G"/>
        <!-- Les tests ne lisent jamais backend/.env (tests/TestCase.php) : tout est défini ici.
             Une variable d'environnement déjà présente l'emporte (intégration continue : DB_*). -->
        <env name="APP_ENV" value="testing"/>
        <!-- Clé publique, réservée aux tests (aucune donnée réelle n'est chiffrée avec). -->
        <env name="APP_KEY" value="base64:LyJwAsZ7QCzY/P16286EvGLlxTECLeHfnD6p26GUb2I="/>
        <env name="APP_DEBUG" value="false"/>
        <env name="APP_URL" value="http://localhost"/>
        <env name="FRONTEND_URL" value="http://localhost:3000"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="MEDIA_DISK" value="public"/>
        <env name="SEED_DEMO_DATA" value="false"/>
        <!-- Accès anticipé désactivé par défaut dans les tests (les projets publiés pendant un
             test sont visibles tout de suite) ; tests/Feature/Directory/EarlyAccessTest.php le
             réactive avec la valeur de production. -->
        <env name="DIRECTORY_EARLY_ACCESS_HOURS" value="0"/>
        <env name="DIRECTORY_FREE_PROJECT_ACCESS" value="true"/>
        <!-- IA simulée (aucun appel réseau, Http::preventStrayRequests en plus) : les tests du
             pilote désactivé et du pilote Mistral changent ai.driver eux-mêmes. -->
        <env name="AI_DRIVER" value="fake"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
